{
  "name": "doptor-super-app",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "node ./node_modules/@playwright/test/cli.js install --with-deps chromium",
    "test:e2e:ci": "node ./node_modules/@playwright/test/cli.js test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "only-allow": "^1.2.1",
    "prettier": "latest",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turbo": "latest"
  },
  "packageManager": "pnpm@9.1.0"
}
